---
interface Props {
  title: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
  lang?: string;
}

const {
  title,
  description = "Robert Romero Medina — Fullstack Developer with 6+ years of experience (since 2020) building modern, responsive web applications and SaaS products. Based in Boston, MA.",
  image = "/full.jpg",
  hideFooter = false,
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <meta
      name="author"
      content="Robert Romero Medina, Fullstack Developer with 6+ years specializing in scalable web applications and SaaS products."
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <slot />
    {!hideFooter && <footer class="text-center py-6 text-gray-500 text-sm border-t border-white/5">© 2026 Robert Frontend</footer>}
  </body>
</html>
<style is:global>
  html {
    font-family: "Plus Jakarta Sans", sans-serif;
    background: #0f022e;
    color: white;
  }
  body {
    overflow-x: hidden;
  }
</style>

