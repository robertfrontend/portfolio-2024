---
interface Props {
  title: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
  lang?: string;
}

const {
  title,
  description = "Robert Romero Medina — Software Developer & Product Builder with 6+ years of experience (since 2020) building modern, responsive web applications and SaaS products. Based in Boston, MA.",
  image = "/og.jpg",
  hideFooter = false,
  lang = "en",
} = Astro.props;

const site = Astro.site ?? new URL("https://www.robertfrontend.com");

function absolutePageUrl(pathname: string) {
  const url = new URL(pathname, site);
  if (url.pathname.length > 1 && url.pathname.endsWith("/")) {
    url.pathname = url.pathname.replace(/\/+$/, "");
  }
  return url;
}

const canonicalURL = absolutePageUrl(Astro.url.pathname);
const socialImage = new URL(image, site);
const englishURL = new URL("/", site);
const spanishURL = new URL("/es", site);
const isLanguageHome = canonicalURL.pathname === "/" || canonicalURL.pathname === "/es";

const personJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Robert Romero",
  url: englishURL.href,
  jobTitle: "Software Developer & Product Builder",
  sameAs: [
    "https://x.com/robertfrontend",
    "https://github.com/robertfrontend",
    "https://www.linkedin.com/in/robertfrontend/",
    "https://www.instagram.com/robertfrontend",
  ],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />
    {
      isLanguageHome && (
        <>
          <link rel="alternate" hreflang="en" href={englishURL} />
          <link rel="alternate" hreflang="es" href={spanishURL} />
          <link rel="alternate" hreflang="x-default" href={englishURL} />
        </>
      )
    }

    <meta name="author" content="Robert Romero" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    {
      image === "/og.jpg" && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content="Robert Romero" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={personJson} />
  </head>
  <body>
    <slot />
    {!hideFooter && <footer class="text-center py-6 text-gray-500 text-sm border-t border-white/5">© 2026 Robert Frontend</footer>}
  </body>
</html>
<style is:global>
  html:root {
    font-family: "Plus Jakarta Sans", sans-serif;
    background-color: #070a13;
    color: #f4f4f5;
    color-scheme: dark;
  }
  body {
    overflow-x: hidden;
  }
  :focus-visible {
    outline: 2px solid #c3b2fd;
    outline-offset: 3px;
  }
</style>

