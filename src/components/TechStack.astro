---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isEs = lang === "es";

const skillCategories = [
  {
    title: isEs ? "Desarrollo Frontend" : "Frontend Development",
    icon: "💻",
    description: isEs
      ? "Construyendo interfaces rápidas, dinámicas y accesibles."
      : "Building fast, dynamic, and accessible interfaces.",
    skills: [
      { name: "React", level: "Advanced" },
      { name: "Next.js", level: "Advanced" },
      { name: "Astro", level: "Advanced" },
      { name: "TypeScript", level: "Advanced" },
      { name: "JavaScript (ES6+)", level: "Advanced" },
      { name: "Tailwind CSS", level: "Advanced" },
      { name: "HTML5 / CSS3", level: "Expert" },
    ],
  },
  {
    title: "Backend & APIs",
    icon: "⚙️",
    description: isEs
      ? "Arquitectura de lógica de servidor confiable y APIs escalables."
      : "Architecting reliable server logic and scalable APIs.",
    skills: [
      { name: "Node.js", level: "Advanced" },
      { name: "Express.js", level: "Intermediate" },
      { name: "RESTful APIs", level: "Advanced" },
      { name: "Cloud Functions", level: "Intermediate" },
    ],
  },
  {
    title: isEs ? "Bases de Datos & BaaS" : "Databases & BaaS",
    icon: "🔥",
    description: isEs
      ? "Diseño de bases de datos en tiempo real, autenticación y almacenamiento en la nube."
      : "Designing real-time databases, authentication, and cloud storage.",
    skills: [
      { name: "Firebase", level: "Advanced" },
      { name: "Cloud Firestore", level: "Advanced" },
      { name: "Firebase Auth", level: "Advanced" },
      { name: "MongoDB", level: "Intermediate" },
      { name: "Supabase", level: "Intermediate" },
    ],
  },
  {
    title: isEs ? "Herramientas & Flujo" : "Tools & Workflow",
    icon: "🛠️",
    description: isEs
      ? "Garantizando desarrollo ágil, pruebas e implementación continua."
      : "Ensuring smooth development, testing, and deployment.",
    skills: [
      { name: "Git & GitHub", level: "Advanced" },
      { name: "Vercel", level: "Advanced" },
      { name: "Docker", level: "Intermediate" },
      { name: "Figma", level: "Advanced" },
      { name: "Vite", level: "Advanced" },
      { name: "Postman", level: "Intermediate" },
    ],
  },
];
---

<section id="skills" class="py-16 md:py-24 border-t border-white/5">
  <div class="text-center mb-16">
    <span
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-4"
    >
      {isEs ? "Diseñado para la Calidad" : "Engineered for Quality"}
    </span>
    <h3 class="text-3xl md:text-5xl font-bold text-white tracking-tight mb-4">
      {isEs ? "Tecnologías & Stack" : "Technologies & Stack"}
    </h3>
    <p class="text-gray-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
      {isEs
        ? "Un conjunto probado de herramientas, librerías y frameworks modernos que utilizo para desarrollar aplicaciones web escalables y de alto rendimiento."
        : "A battle-tested set of modern tools, libraries, and frameworks I use to engineer scalable, high-performance web applications."}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      skillCategories.map((category) => (
        <div class="p-8 bg-[#0d1322]/80 border border-white/[0.08] rounded-3xl hover:border-violet-500/40 hover:bg-[#0d1322] transition-all duration-300 group flex flex-col justify-between shadow-xl shadow-black/40">
          <div>
            <div class="flex items-center gap-4 mb-4">
              <span class="text-3xl p-3 bg-white/[0.03] rounded-2xl border border-white/[0.08] group-hover:scale-110 transition-transform">
                {category.icon}
              </span>
              <div>
                <h4 class="text-xl font-bold text-white group-hover:text-violet-300 transition-colors">
                  {category.title}
                </h4>
                <p class="text-xs md:text-sm text-gray-400 mt-0.5">{category.description}</p>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 mt-6 pt-6 border-t border-white/5">
            {category.skills.map((skill) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.03] hover:bg-violet-600/20 border border-white/[0.06] hover:border-violet-500/40 text-gray-300 hover:text-white text-xs font-medium transition-all duration-200">
                <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
