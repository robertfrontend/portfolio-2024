---
interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const isEs = lang === "es";

const t = {
  badge: isEs ? "En Resumen" : "At a Glance",
  title: isEs ? "Arquitectura, Productos & Impacto" : "Architecture, Products & Impact",
  subtitle: isEs
    ? "Combinando rigor técnico, visión de producto y arquitectura fullstack para crear software rápido y escalable."
    : "Combining engineering rigour, product intuition, and modern fullstack design to create fast, scalable digital software.",
  studioBadge: isEs ? "SaaS & Herramientas Destacadas" : "Featured Product Studio",
  exploreStudio: isEs ? "Explorar Studio" : "Explore Studio",
  studioLink: isEs ? "/product-studio/es" : "/product-studio",
  studioHeadline: isEs ? "Construyendo y monetizando herramientas de software" : "Building and monetizing software products",
  studioDesc: isEs
    ? "Herramientas micro-SaaS independientes diseñadas para resolver cuellos de botella reales en gestión de restaurantes, citas y deportes."
    : "Independent micro-SaaS tools designed to solve real business bottlenecks in restaurant management, scheduling, and sports data.",
  liveSaaS: isEs ? "SaaS Activo" : "Live SaaS",
  liveApp: isEs ? "App Activa" : "Live App",
  menuDesc: isEs ? "Menús inteligentes y pedidos en mesa para restaurantes." : "Smart restaurant menus & table ordering system.",
  thiscitaDesc: isEs ? "Agendamiento automatizado de citas y reservas." : "Automated appointment scheduling & client bookings.",
  liguitaDesc: isEs ? "Gestión de torneos y ligas deportivas en tiempo real." : "Real-time amateur baseball league management.",
  journeyBadge: isEs ? "Trayectoria y Origen" : "Developer Journey",
  journeyTitle: isEs ? "De República Dominicana a Boston, MA" : "From Dominican Republic to Boston, MA",
  journeyText: isEs
    ? "Becado en 2019 por Platzi & Facebook Developer Circles. 6+ años (desde 2020) convirtiendo requerimientos complejos en software escalable."
    : "Awarded a competitive scholarship in 2019 by Platzi & Facebook Developer Circles. 6+ years (since 2020) turning complex design into scalable, bulletproof software.",
  location: "Boston, Massachusetts",
  timeZone: isEs ? "Hora del Este (EE. UU. / Remoto)" : "Eastern Time (US / Remote)",
  trackRecord: isEs ? "Métricas Clave" : "Track Record",
  yearsExp: isEs ? "Años de Experiencia" : "Years Experience",
  shippedProjects: isEs ? "Proyectos Lanzados" : "Shipped Projects",
  activeSaaS: isEs ? "Herramientas SaaS" : "Active SaaS Tools",
  cleanTs: isEs ? "TypeScript Limpio" : "Clean TypeScript",
  trackRecordDesc: isEs
    ? "Especializado en arquitecturas cliente modernas, servicios backend serverless y UX de alto rendimiento."
    : "Specialized in modern client-side architectures, serverless backends, and responsive UX.",
  coreBadge: isEs ? "Habilidades Principales" : "Core Competencies",
  fullStackLink: isEs ? "Ver Todo el Stack ↓" : "Full Tech Stack ↓",
  stackAnchor: "#skills",
  stackHeadline: isEs ? "Ecosistema Moderno TypeScript & React" : "Modern TypeScript & React Ecosystem",
  stackDesc: isEs
    ? "Creando software web accesible y mantenible con estándares modernos. Cero código innecesario, enfocado en componentes y Core Web Vitals."
    : "Crafting maintainable, accessible web software with the modern standard toolchain. Zero bloat, component-driven, and highly optimized for Core Web Vitals.",
};
---

<section id="bento" class="py-16 md:py-24">
  <div class="text-center mb-12 md:mb-16">
    <span
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-4"
    >
      {t.badge}
    </span>
    <h3 class="text-3xl md:text-5xl font-bold text-white tracking-tight">
      {t.title}
    </h3>
    <p class="text-gray-400 text-base md:text-lg max-w-2xl mx-auto mt-3">
      {t.subtitle}
    </p>
  </div>

  <!-- Bento Grid Container -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Card 1: Product Studio Showcase (Span 2) -->
    <div
      class="md:col-span-2 relative group overflow-hidden rounded-3xl bg-[#0d1322]/80 border border-white/[0.08] hover:border-emerald-500/40 p-6 md:p-8 transition-all duration-500 shadow-xl shadow-black/40 flex flex-col justify-between"
    >
      <!-- Glow effect -->
      <div
        class="absolute -top-20 -right-20 w-64 h-64 bg-emerald-500/10 blur-[90px] rounded-full group-hover:bg-emerald-500/20 transition-all pointer-events-none"
      >
      </div>

      <div>
        <div class="flex items-center justify-between gap-4 mb-6">
          <span
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wider uppercase"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            {t.studioBadge}
          </span>
          <a
            href={t.studioLink}
            class="text-xs md:text-sm font-semibold text-gray-400 hover:text-white flex items-center gap-1 transition-colors"
          >
            {t.exploreStudio}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover:translate-x-1 transition-transform"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>
        </div>

        <h4 class="text-2xl md:text-3xl font-bold text-white mb-2 tracking-tight">
          {t.studioHeadline}
        </h4>
        <p class="text-gray-400 text-sm md:text-base leading-relaxed max-w-xl">
          {t.studioDesc}
        </p>
      </div>

      <!-- 3 Products Mini Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mt-8">
        <a
          href="https://menudrapp.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.06] hover:border-emerald-500/30 transition-all group/item"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(16,185,129,0.6)]"></span>
            <span class="text-[10px] uppercase font-bold text-emerald-400 tracking-wider">{t.liveSaaS}</span>
          </div>
          <p class="text-white font-bold text-base group-hover/item:text-emerald-300 transition-colors">MenuDrapp</p>
          <p class="text-gray-400 text-xs mt-1 line-clamp-2">{t.menuDesc}</p>
        </a>

        <a
          href="https://thiscita.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.06] hover:border-blue-500/30 transition-all group/item"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="w-2 h-2 rounded-full bg-blue-400 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></span>
            <span class="text-[10px] uppercase font-bold text-blue-400 tracking-wider">{t.liveSaaS}</span>
          </div>
          <p class="text-white font-bold text-base group-hover/item:text-blue-300 transition-colors">Thiscita</p>
          <p class="text-gray-400 text-xs mt-1 line-clamp-2">{t.thiscitaDesc}</p>
        </a>

        <a
          href="https://laliguita.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.06] hover:border-orange-500/30 transition-all group/item"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="w-2 h-2 rounded-full bg-orange-400 shadow-[0_0_8px_rgba(249,115,22,0.6)]"></span>
            <span class="text-[10px] uppercase font-bold text-orange-400 tracking-wider">{t.liveApp}</span>
          </div>
          <p class="text-white font-bold text-base group-hover/item:text-orange-300 transition-colors">La Liguita</p>
          <p class="text-gray-400 text-xs mt-1 line-clamp-2">{t.liguitaDesc}</p>
        </a>
      </div>
    </div>

    <!-- Card 2: Background & Origin (Span 1) -->
    <div
      class="relative group overflow-hidden rounded-3xl bg-[#0d1322]/80 border border-white/[0.08] hover:border-violet-500/40 p-6 md:p-8 transition-all duration-500 shadow-xl shadow-black/40 flex flex-col justify-between"
    >
      <div
        class="absolute -top-10 -left-10 w-48 h-48 bg-violet-600/10 blur-[70px] rounded-full group-hover:bg-violet-600/20 transition-all pointer-events-none"
      >
      </div>

      <div>
        <span
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-6"
        >
          {t.journeyBadge}
        </span>
        <h4 class="text-xl font-bold text-white mb-3">
          {t.journeyTitle}
        </h4>
        <p class="text-gray-400 text-sm leading-relaxed">
          {t.journeyText}
        </p>
      </div>

      <div class="mt-6 pt-6 border-t border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xl">📍</span>
          <div>
            <p class="text-white text-xs font-semibold">{t.location}</p>
            <p class="text-gray-500 text-[11px]">{t.timeZone}</p>
          </div>
        </div>
        <span class="text-2xl">🇩🇴</span>
      </div>
    </div>

    <!-- Card 3: Metrics & Impact (Span 1) -->
    <div
      class="relative group overflow-hidden rounded-3xl bg-[#0d1322]/80 border border-white/[0.08] hover:border-white/20 p-6 md:p-8 transition-all duration-500 shadow-xl shadow-black/40 flex flex-col justify-between"
    >
      <span
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-gray-300 text-xs font-semibold tracking-wider uppercase mb-6 self-start"
      >
        {t.trackRecord}
      </span>

      <div class="grid grid-cols-2 gap-4 my-2">
        <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <span class="text-3xl md:text-4xl font-extrabold text-white">6+</span>
          <p class="text-xs text-gray-400 mt-1 font-medium">{t.yearsExp}</p>
        </div>
        <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <span class="text-3xl md:text-4xl font-extrabold text-emerald-400">15+</span>
          <p class="text-xs text-gray-400 mt-1 font-medium">{t.shippedProjects}</p>
        </div>
        <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <span class="text-3xl md:text-4xl font-extrabold text-violet-400">3</span>
          <p class="text-xs text-gray-400 mt-1 font-medium">{t.activeSaaS}</p>
        </div>
        <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.05]">
          <span class="text-3xl md:text-4xl font-extrabold text-blue-400">100%</span>
          <p class="text-xs text-gray-400 mt-1 font-medium">{t.cleanTs}</p>
        </div>
      </div>

      <p class="text-xs text-gray-500 mt-4">
        {t.trackRecordDesc}
      </p>
    </div>

    <!-- Card 4: Core Stack & Philosophy (Span 2) -->
    <div
      class="md:col-span-2 relative group overflow-hidden rounded-3xl bg-[#0d1322]/80 border border-white/[0.08] hover:border-violet-500/40 p-6 md:p-8 transition-all duration-500 shadow-xl shadow-black/40 flex flex-col justify-between"
    >
      <div
        class="absolute -bottom-10 -right-10 w-48 h-48 bg-violet-600/10 blur-[80px] rounded-full group-hover:bg-violet-600/20 transition-all pointer-events-none"
      >
      </div>

      <div>
        <div class="flex items-center justify-between gap-4 mb-4">
          <span
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold tracking-wider uppercase"
          >
            {t.coreBadge}
          </span>
          <a
            href={t.stackAnchor}
            class="text-xs md:text-sm font-semibold text-gray-400 hover:text-white flex items-center gap-1 transition-colors"
          >
            {t.fullStackLink}
          </a>
        </div>

        <h4 class="text-2xl font-bold text-white mb-2 tracking-tight">
          {t.stackHeadline}
        </h4>
        <p class="text-gray-400 text-sm leading-relaxed max-w-xl">
          {t.stackDesc}
        </p>
      </div>

      <div class="flex flex-wrap gap-2 mt-6 pt-6 border-t border-white/5">
        <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white text-xs font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#61DAFB]"></span> React / Next.js
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white text-xs font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF5D01]"></span> Astro SSG
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white text-xs font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#3178C6]"></span> TypeScript
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white text-xs font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#38BDF8]"></span> Tailwind CSS
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white text-xs font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#68A063]"></span> Node.js / Express
        </span>
        <span class="px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white text-xs font-medium flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FFA611]"></span> Firebase (Firestore & Auth)
        </span>
      </div>
    </div>

  </div>
</section>
