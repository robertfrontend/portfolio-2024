---
import { projects } from "../data/projects";

interface Props {
  lang?: "en" | "es";
  featuredOnly?: boolean;
}

const { lang = "en", featuredOnly = false } = Astro.props;
const isEs = lang === "es";
const list = featuredOnly ? projects.filter((project) => project.featured) : projects;
---

<ul class="mt-8 border-t border-white/10">
  {
    list.map((project) => {
      const label = project.status
        ? isEs
          ? project.status.es
          : project.status.en
        : project.date;
      return (
        <li class="relative border-b border-white/10">
          <div class="group grid grid-cols-1 items-start gap-4 py-5 sm:grid-cols-[13.75rem_minmax(0,1fr)] sm:gap-5 sm:py-6">
            <div class="overflow-hidden rounded-md bg-[#10141c]">
              <img
                src={project.img}
                alt={isEs ? project.alt.es : project.alt.en}
                width="720"
                height="450"
                loading="lazy"
                decoding="async"
                sizes="(min-width: 640px) 220px, 100vw"
                class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
              />
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                {project.link ? (
                  <h3 class="font-display text-lg font-medium tracking-tight text-white group-hover:text-[#ddd6fe] sm:text-xl">
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="after:absolute after:inset-0 after:content-[''] focus:outline-none focus:underline"
                    >
                      {project.name}
                    </a>
                  </h3>
                ) : (
                  <h3 class="font-display text-lg font-medium tracking-tight text-white sm:text-xl">
                    {project.name}
                  </h3>
                )}
                {label && <span class="text-sm text-[#c5cad6]">{label}</span>}
              </div>
              <p class="mt-2 text-[15px] leading-relaxed text-[#e4e6ee] sm:text-base">
                {isEs ? project.description.es : project.description.en}
              </p>
              {project.tags && project.tags.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-1.5 text-xs text-[#c5cad6]">
                  {project.tags.map((tag) => (
                    <span class="rounded bg-white/5 px-2 py-0.5 border border-white/10">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </li>
      );
    })
  }
</ul>
