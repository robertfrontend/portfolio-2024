---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import BentoGrid from "../../components/BentoGrid.astro";
import TechStack from "../../components/TechStack.astro";
import Social from "../../components/Social.astro";

const services = [
  {
    title: "Aplicaciones Web Fullstack",
    description:
      "Arquitectura de aplicaciones web rápidas, accesibles y escalables utilizando React, Next.js, Astro y TypeScript.",
    icon: "🌐",
    badge: "Especialidad",
  },
  {
    title: "Ingeniería de Micro-SaaS",
    description:
      "Transformando ideas en productos de software: modelado de datos, autenticación, pasarelas de pago y despliegue continuo.",
    icon: "🚀",
    badge: "Listo para Producción",
  },
  {
    title: "Sistemas UI/UX de Alta Fidelidad",
    description:
      "Convirtiendo requerimientos complejos en interfaces interactivas y pixel-perfect con Tailwind CSS y animaciones fluidas.",
    icon: "🎨",
    badge: "Enfocado en Diseño",
  },
  {
    title: "Rendimiento & Optimización SEO",
    description:
      "Maximizando Core Web Vitals, renderizado del lado del servidor (SSR) y optimización de activos para mínima latencia.",
    icon: "⚡",
    badge: "Velocidad & SEO",
  },
];
---

<Layout
  lang="es"
  title="Robert Romero — Desarrollador Fullstack & Creador de Productos"
  description="Desarrollador Fullstack con más de 6 años de experiencia (desde 2020) creando aplicaciones web de alto rendimiento y plataformas digitales. Radicado en Boston, MA."
  image="/og.jpg"
  hideFooter={true}
>
  <div class="text-white font-sans bg-[#070a13] overflow-x-clip relative min-h-screen selection:bg-violet-600/30">
    <!-- Ambient Background Glows (Linear / Vercel style) -->
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-violet-600/15 via-purple-600/5 to-transparent blur-[140px] pointer-events-none -z-10"
    >
    </div>
    <div
      class="fixed bottom-0 right-0 w-[600px] h-[600px] bg-emerald-500/5 blur-[160px] pointer-events-none -z-10"
    >
    </div>
    <div
      class="fixed top-1/2 left-0 w-[500px] h-[500px] bg-blue-500/5 blur-[160px] pointer-events-none -z-10"
    >
    </div>

    <!-- Floating Navbar -->
    <Header lang="es" />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 pb-20">
      <!-- Hero Section -->
      <section class="text-center pt-6 pb-16 md:pt-10 md:pb-24 flex flex-col items-center">
        <!-- Live Status Pill -->
        <div class="mb-8 inline-flex items-center">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs sm:text-sm font-medium tracking-wide shadow-lg shadow-emerald-500/5"
          >
            <span class="relative flex h-2.5 w-2.5">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"
              ></span>
            </span>
            Disponible para roles a tiempo completo y contratos de alto impacto
          </span>
        </div>

        <!-- Avatar with Ambient Glow -->
        <div class="relative group mb-8">
          <div
            class="absolute -inset-1 bg-gradient-to-r from-violet-600 via-purple-600 to-emerald-500 rounded-full blur-md opacity-40 group-hover:opacity-75 transition duration-1000 group-hover:duration-300"
          >
          </div>
          <img
            src="/full.webp"
            class="relative w-[130px] h-[130px] md:w-[170px] md:h-[170px] object-cover rounded-full border-2 border-white/20 shadow-2xl"
            alt="Robert Romero Medina"
            width="170"
            height="170"
            loading="eager"
          />
        </div>

        <!-- Headline -->
        <div class="max-w-4xl mx-auto">
          <h1
            class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.15]"
          >
            Construyendo aplicaciones web escalables <br class="hidden sm:inline" />
            <span class="text-white/80">&amp;</span>
            <span
              class="bg-clip-text text-transparent bg-gradient-to-r from-violet-400 via-purple-300 to-emerald-400 inline-block"
            >
              plataformas digitales.
            </span>
          </h1>

          <p
            class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto mt-6 leading-relaxed font-light"
          >
            Hola, soy <span class="text-white font-medium">Robert Romero</span>, Desarrollador Fullstack & Creador de Productos radicado en <span class="text-violet-300 font-medium">Boston, MA</span>. Especializado en ingeniería frontend de alto rendimiento, TypeScript y desarrollo de herramientas micro-SaaS.
          </p>
        </div>

        <!-- Hero Actions / CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 my-10 items-center justify-center flex-wrap">
          <button
            type="button"
            class="contact-trigger px-7 py-3.5 bg-violet-600 hover:bg-violet-500 text-white font-semibold rounded-full transition-all shadow-xl shadow-violet-600/30 hover:shadow-violet-600/50 flex items-center gap-2.5 text-base cursor-pointer"
          >
            <span>💬 Hablemos</span>
          </button>

          <a
            href="/projects"
            class="px-7 py-3.5 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full border border-white/10 hover:border-white/20 transition-all flex items-center gap-2 text-base"
          >
            <span>Explorar Proyectos</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M7 7h10v10" />
              <path d="M7 17 17 7" />
            </svg>
          </a>

          <a
            href="/product-studio/es"
            class="px-7 py-3.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 font-semibold rounded-full border border-emerald-500/20 hover:border-emerald-500/40 transition-all flex items-center gap-2 text-base"
          >
            <span>🚀 Product Studio</span>
          </a>
        </div>

        <!-- Social Bar -->
        <div class="opacity-80 hover:opacity-100 transition-opacity">
          <Social />
        </div>
      </section>

      <!-- Bento Grid (Overview, Stats, SaaS Products, Heritage) -->
      <BentoGrid lang="es" />

      <!-- Tech Stack Section -->
      <TechStack lang="es" />

      <!-- Services Section -->
      <section id="services" class="py-16 md:py-24 border-t border-white/5">
        <div class="text-center mb-16">
          <span
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-4"
          >
            Servicios
          </span>
          <h3 class="text-3xl md:text-5xl font-bold text-white tracking-tight mb-4">
            Servicios Especializados
          </h3>
          <p class="text-gray-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
            Excelencia en ingeniería de software de punta a punta: desde el diseño de arquitectura hasta la puesta en producción.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            services.map((service) => (
              <div class="p-8 bg-[#0d1322]/80 border border-white/[0.08] rounded-3xl hover:border-violet-500/40 hover:bg-[#0d1322] transition-all duration-300 group flex flex-col justify-between shadow-xl shadow-black/40">
                <div>
                  <div class="flex items-center justify-between gap-4 mb-6">
                    <span class="text-3xl p-3 bg-white/[0.03] rounded-2xl border border-white/[0.08] group-hover:scale-110 transition-transform">
                      {service.icon}
                    </span>
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-gray-400">
                      {service.badge}
                    </span>
                  </div>
                  <h4 class="text-xl font-bold text-white mb-3 group-hover:text-violet-300 transition-colors">
                    {service.title}
                  </h4>
                  <p class="text-gray-400 leading-relaxed text-sm md:text-base">
                    {service.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- High-Impact CTA Banner (Linear/Vercel Style) -->
      <section class="py-16 md:py-24">
        <div
          class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-[#12192e] via-[#0d1322] to-[#070a13] border border-white/10 p-8 sm:p-12 md:p-16 text-center shadow-2xl shadow-black/50"
        >
          <div
            class="absolute top-0 right-0 w-96 h-96 bg-violet-600/10 blur-[100px] rounded-full pointer-events-none"
          >
          </div>
          <div
            class="absolute bottom-0 left-0 w-96 h-96 bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"
          >
          </div>

          <div class="relative z-10 max-w-2xl mx-auto">
            <span
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wider uppercase mb-6"
            >
              Iniciemos una Conversación
            </span>
            <h3 class="text-3xl sm:text-5xl font-bold text-white tracking-tight leading-tight mb-6">
              ¿Tienes un proyecto o una oportunidad en mente?
            </h3>
            <p class="text-gray-400 text-base sm:text-lg leading-relaxed mb-8">
              Ya sea que busques un ingeniero fullstack para tu equipo, quieras colaborar en un nuevo producto SaaS o necesites una plataforma web moderna, me encantaría conversar.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
              <button
                type="button"
                class="contact-trigger w-full sm:w-auto px-8 py-4 bg-violet-600 hover:bg-violet-500 text-white font-semibold rounded-full transition-all shadow-xl shadow-violet-600/30 hover:shadow-violet-600/50 text-base cursor-pointer"
              >
                Hablemos
              </button>
              <a
                href="https://github.com/robertfrontend/portfolio-2024"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full border border-white/10 hover:border-white/20 transition-all text-base flex items-center justify-center gap-2"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon
                    points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                  ></polygon>
                </svg>
                <span>Ver en GitHub</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="text-gray-500 text-center py-8 border-t border-white/5 text-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>&copy; 2026 Robert Romero Medina. Creado con Astro & Tailwind.</p>
        <div class="flex items-center gap-6 text-xs text-gray-400">
          <a href="/product-studio/es" class="hover:text-white transition-colors">Product Studio</a>
          <a href="/links" class="hover:text-white transition-colors">Enlaces</a>
          <a href="https://github.com/robertfrontend" target="_blank" class="hover:text-white transition-colors">GitHub</a>
          <a href="https://linkedin.com/in/robertfrontend" target="_blank" class="hover:text-white transition-colors">LinkedIn</a>
          <a href="https://x.com/robertfrontend" target="_blank" class="hover:text-white transition-colors">X (Twitter)</a>
        </div>
      </footer>
    </main>

    <!-- Glassmorphic Contact Modal -->
    <dialog id="modalContact" class="modal">
      <div
        class="modal-box bg-[#0d1322]/95 border border-white/10 text-center shadow-2xl shadow-violet-500/20 backdrop-blur-2xl max-w-md p-8 rounded-3xl"
      >
        <div class="w-12 h-12 rounded-2xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center mx-auto mb-4 text-2xl">
          💬
        </div>
        <h3 class="font-bold text-white text-2xl mb-2">Hablemos</h3>
        <p class="text-gray-400 text-sm mb-6">
          Disponible para proyectos a medida y colaboraciones a través de los siguientes canales.
        </p>

        <ul class="space-y-3">
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="mailto:robert@robertfrontend.com"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-violet-600/20 border border-white/[0.08] hover:border-violet-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">✉️</span>
                <span>Email</span>
              </div>
              <span class="text-xs text-violet-300 font-mono">robert@robertfrontend.com</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://wa.me/18573975959"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-emerald-600/20 border border-white/[0.08] hover:border-emerald-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">📱</span>
                <span>WhatsApp</span>
              </div>
              <span class="text-xs text-emerald-300 font-mono">+1 (857) 397-5959</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://x.com/robertfrontend"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-sky-600/20 border border-white/[0.08] hover:border-sky-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">𝕏</span>
                <span>X (Twitter)</span>
              </div>
              <span class="text-xs text-sky-300 font-mono">@robertfrontend</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://linkedin.com/in/robertfrontend"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-blue-600/20 border border-white/[0.08] hover:border-blue-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">💼</span>
                <span>LinkedIn</span>
              </div>
              <span class="text-xs text-blue-300">/in/robertfrontend</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://instagram.com/robertfrontend"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-pink-600/20 border border-white/[0.08] hover:border-pink-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">📸</span>
                <span>Instagram</span>
              </div>
              <span class="text-xs text-pink-300">@robertfrontend</span>
            </a>
          </li>
        </ul>

        <div class="modal-action mt-6 flex justify-center">
          <form method="dialog">
            <button
              class="px-6 py-2 rounded-full text-xs font-semibold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors cursor-pointer"
              >Cerrar</button
            >
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop bg-black/70 backdrop-blur-md">
        <button>close</button>
      </form>
    </dialog>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const contactButtons = document.querySelectorAll(".contact-trigger");
    const modal = document.getElementById("modalContact");
    if (modal && contactButtons.length > 0) {
      contactButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          (modal as HTMLDialogElement).showModal();
        });
      });
    }
  });
</script>
