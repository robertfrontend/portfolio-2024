---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProjectList from "../components/ProjectList.astro";
import ContactSection from "../components/ContactSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout
  title="Robert Romero — Projects Archive"
  description="Explore the portfolio of web applications, platforms, and digital products built by Robert Romero Medina."
  hideFooter={true}
>
  <div class="min-h-screen bg-[#070a13] text-[#f4f4f5]">
    <Header lang="en" />
    <main class="mx-auto max-w-3xl px-5 pb-4 pt-20 sm:pt-24">
      <section id="work" class="scroll-mt-24 pb-2 pt-6 sm:pt-10">
        <h1 class="font-display text-4xl font-medium leading-[1.05] tracking-tight text-white sm:text-5xl">
          Projects
        </h1>
        <p class="mt-5 max-w-[38rem] text-lg leading-relaxed text-[#e4e6ee]">
          Web applications and platforms I have shipped, including the ones featured on the home page.
        </p>
        <ProjectList lang="en" />
      </section>
      <ContactSection lang="en" />
    </main>
    <SiteFooter lang="en" />
  </div>
</Layout>

<style is:global>
  /* DaisyUI's light theme paints :root white and outranks the layout's html rule.
     Keep the document canvas the same near-black as the home page, including
     behind the shared layout footer. */
  html:root {
    background-color: #070a13;
    color: #ffffff;
  }
</style>
