---
import Layout from "../../layouts/Layout.astro";

const mainLinks = [
  {
    name: "Personal Portfolio",
    url: "/",
    icon: "🌐",
    description: "My work and experience as a Software Developer & Product Builder",
    color: "from-blue-500/20 to-blue-600/20",
    borderColor: "group-hover:border-blue-500/50",
  },
  {
    name: "Product Studio",
    url: "/product-studio/en",
    icon: "🚀",
    description: "Explore my digital products and tools",
    color: "from-emerald-500/20 to-emerald-600/20",
    borderColor: "group-hover:border-emerald-500/50",
  },
  {
    name: "MenuDrapp",
    url: "https://menudrapp.com",
    icon: "🍽️",
    description: "Smart management for restaurants",
    color: "from-emerald-400/20 to-emerald-500/20",
    borderColor: "group-hover:border-emerald-400/50",
  },
  {
    name: "Thiscita",
    url: "https://thiscita.com",
    icon: "📅",
    description: "Appointment and booking system",
    color: "from-blue-400/20 to-blue-500/20",
    borderColor: "group-hover:border-blue-400/50",
  },
  {
    name: "La Liguita",
    url: "https://laliguita.vercel.app",
    icon: "⚽",
    description: "Real-time sports league management",
    color: "from-orange-500/20 to-orange-600/20",
    borderColor: "group-hover:border-orange-500/50",
  },
  {
    name: "Download CV",
    url: "/RobertCV2026.pdf",
    icon: "📄",
    description: "My professional journey in detail",
    color: "from-violet-500/20 to-violet-600/20",
    borderColor: "group-hover:border-violet-500/50",
  },
];

const socialLinks = [
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/robertfrontend",
    icon: "💼",
  },
  {
    name: "GitHub",
    url: "https://github.com/robertfrontend",
    icon: "💻",
  },
  {
    name: "X (Twitter)",
    url: "https://x.com/robertfrontend",
    icon: "𝕏",
  },
  {
    name: "Instagram",
    url: "https://instagram.com/robertfrontend",
    icon: "📸",
  },
  {
    name: "WhatsApp",
    url: "https://wa.me/18573975959",
    icon: "💬",
  },
];
---

<Layout title="Links | Robert Romero Medina">
  <main class="min-h-screen bg-dark-purple relative overflow-hidden flex flex-col items-center py-12 px-4 selection:bg-violet-500/30">
    <!-- Glow effects consistent with index.astro -->
    <div class="absolute top-[-5%] left-[-10%] w-[50%] h-[40%] bg-violet-600/20 blur-[120px] rounded-full -z-10"></div>
    <div class="absolute bottom-[5%] right-[-10%] w-[40%] h-[40%] bg-violet-500/10 blur-[100px] rounded-full -z-10"></div>

    <!-- Language Switcher -->
    <div class="absolute top-6 right-6 z-50 flex items-center gap-1 bg-white/5 backdrop-blur-md border border-white/10 px-2 py-1.5 rounded-full shadow-lg">
      <a
        href="/links"
        class="text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-300 text-slate-400 hover:text-white hover:bg-white/5 border border-transparent"
      >
        ES
      </a>
      <a
        href="/links/en"
        class="text-xs font-semibold px-3 py-1.5 rounded-full transition-all duration-300 bg-white/10 text-white border border-white/10"
      >
        EN
      </a>
    </div>

    <!-- Profile Section -->
    <header class="text-center mb-10 flex flex-col items-center">
      <div class="relative group mb-6">
        <div class="absolute -inset-1 bg-gradient-to-r from-violet-600 to-purple-600 rounded-full blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
        <img
          src="/full.jpg"
          class="relative w-24 h-24 object-cover rounded-full border-2 border-white/10"
          alt="Robert Romero"
        />
      </div>
      
      <h1 class="text-3xl font-bold text-white">
        Robert Romero
      </h1>
      <p class="text-violet-300 font-light mt-1">Software Developer & Product Builder</p>
      <p class="text-gray-400 text-sm max-w-xs mt-3">
        Building the future of digital platforms from Boston, MA 🇩🇴
      </p>
    </header>

    <!-- Links Section -->
    <div class="w-full max-w-md space-y-4">
      {mainLinks.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith('http') ? "_blank" : "_self"}
          rel={link.url.startsWith('http') ? "noopener noreferrer" : ""}
          class="group block relative"
        >
          <div class={`absolute inset-0 bg-gradient-to-r ${link.color} rounded-2xl blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>
          <div class={`relative flex items-center p-4 bg-white/5 border border-white/10 rounded-2xl transition-all duration-300 ${link.borderColor} group-hover:translate-y-[-2px] group-active:translate-y-[0px]`}>
            <div class="text-3xl mr-4">{link.icon}</div>
            <div class="flex-1">
              <h2 class="text-white font-bold group-hover:text-white transition-colors">
                {link.name}
              </h2>
              <p class="text-gray-400 text-xs mt-0.5">{link.description}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-500 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Social Section -->
    <div class="mt-12 flex flex-col items-center">
      <h3 class="text-gray-500 text-xs font-semibold uppercase tracking-widest mb-6">Let's Connect</h3>
      <div class="flex gap-4">
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-12 h-12 flex items-center justify-center rounded-full bg-white/5 border border-white/10 text-white/70 hover:text-white hover:bg-violet-600/20 hover:border-violet-500/50 transition-all duration-300"
            aria-label={social.name}
          >
            <span class="text-xl">{social.icon}</span>
          </a>
        ))}
      </div>
    </div>

  </main>
</Layout>

<style>
  main {
    font-family: 'Ubuntu', sans-serif;
  }
</style>
