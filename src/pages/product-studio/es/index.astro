---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";

const products = [
  {
    name: "MenuDrapp",
    slug: "menudrapp",
    url: "https://menudrapp.com",
    tagline: "Menús digitales inteligentes y gestión de pedidos para restaurantes",
    description:
      "Plataforma cloud para optimizar operaciones gastronómicas, reducir tiempos de espera, automatizar pedidos directos por código QR y mantener sincronización en tiempo real entre salón y cocina.",
    status: "Live SaaS",
    color: "#10b981",
    tags: ["Next.js", "React", "TypeScript", "Tailwind CSS", "Firebase", "Real-time DB"],
    metrics: "Optimiza rotación de mesas y pedidos",
  },
  {
    name: "Thiscita",
    slug: "thiscita",
    url: "https://thiscita.com",
    tagline: "Agendamiento automatizado y reservas profesionales",
    description:
      "Sistema inteligente de citas y reservas para proveedores de servicios y profesionales independientes. Reduce cancelaciones e inasistencias mediante flujos de autoservicio y recordatorios automáticos.",
    status: "Live SaaS",
    color: "#3b82f6",
    tags: ["Next.js", "TypeScript", "Tailwind CSS", "Cloud Functions", "Supabase / Firebase"],
    metrics: "Ahorro de horas operativas semanales",
  },
  {
    name: "La Liguita",
    slug: "laliguita",
    url: "https://laliguita.vercel.app",
    tagline: "Gestión deportiva y estadísticas de ligas en tiempo real",
    description:
      "Plataforma integral para organizadores de torneos deportivos: calendarios, tablas de clasificación en vivo, estadísticas de equipos y seguimiento de jugadores con latencia mínima.",
    status: "Live Platform",
    color: "#f97316",
    tags: ["React", "TypeScript", "Tailwind CSS", "Vite", "Real-time APIs"],
    metrics: "Actualizaciones instantáneas de partidos",
  },
];
---

<Layout
  lang="es"
  title="Robert Romero — Product Studio"
  description="Herramientas de software independientes y plataformas SaaS creadas por Robert Romero Medina. MenuDrapp, Thiscita y La Liguita."
  image="/og.jpg"
  hideFooter={true}
>
  <div class="text-white font-sans bg-[#070a13] overflow-x-clip relative min-h-screen selection:bg-violet-600/30">
    <!-- Ambient Background Glows (Linear / Vercel style) -->
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-violet-600/15 via-purple-600/5 to-transparent blur-[140px] pointer-events-none -z-10"
    >
    </div>
    <div
      class="fixed bottom-0 right-0 w-[600px] h-[600px] bg-emerald-500/5 blur-[160px] pointer-events-none -z-10"
    >
    </div>
    <div
      class="fixed top-1/2 left-0 w-[500px] h-[500px] bg-blue-500/5 blur-[160px] pointer-events-none -z-10"
    >
    </div>

    <!-- Floating Navbar -->
    <Header lang="es" />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 pb-20">
      <!-- Hero Section -->
      <section class="text-center pt-8 pb-16 md:pt-12 md:pb-20 flex flex-col items-center">
        <!-- Top Bar: Badge & Language Switcher -->
        <div class="flex items-center justify-center gap-3 mb-8 flex-wrap">
          <span
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs sm:text-sm font-medium tracking-wide shadow-lg shadow-emerald-500/5"
          >
            <span class="relative flex h-2.5 w-2.5">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"
              ></span>
            </span>
            Product Studio &amp; SaaS Lab
          </span>

          <!-- Language Switcher Pill -->
          <div class="inline-flex items-center p-1 rounded-full bg-white/[0.04] border border-white/10 backdrop-blur-md">
            <a
              href="/product-studio"
              class="text-xs font-semibold px-3 py-1 rounded-full transition-all text-gray-400 hover:text-white hover:bg-white/5"
              aria-label="English language"
            >
              EN
            </a>
            <a
              href="/product-studio/es"
              class="text-xs font-semibold px-3 py-1 rounded-full transition-all bg-violet-600 text-white shadow-md shadow-violet-600/30"
              aria-label="Idioma español"
            >
              ES
            </a>
          </div>
        </div>

        <!-- Headline -->
        <div class="max-w-4xl mx-auto">
          <h1
            class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.15]"
          >
            Herramientas de software <br class="hidden sm:inline" />
            <span class="text-white/80">&amp;</span>
            <span
              class="bg-clip-text text-transparent bg-gradient-to-r from-violet-400 via-purple-300 to-emerald-400 inline-block"
            >
              productos escalables.
            </span>
          </h1>

          <p
            class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto mt-6 leading-relaxed font-light"
          >
            Diseño, desarrollo y opero productos digitales independientes orientados a resolver problemas reales de negocio con arquitectura moderna, alta disponibilidad y máxima velocidad.
          </p>
        </div>
      </section>

      <!-- Products Grid -->
      <section class="py-6 flex flex-col gap-8">
        {products.map((product) => (
          <div
            class="relative group overflow-hidden rounded-3xl bg-[#0d1322]/80 border border-white/[0.08] hover:border-violet-500/40 p-8 sm:p-10 md:p-12 transition-all duration-500 shadow-xl shadow-black/40 flex flex-col justify-between"
          >
            <!-- Ambient Card Glow -->
            <div
              class="absolute -top-12 -right-12 w-64 h-64 bg-violet-600/10 blur-[80px] rounded-full group-hover:bg-violet-600/20 transition-all pointer-events-none"
            ></div>

            <div>
              <!-- Header: Brand + Status -->
              <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                <div class="flex items-center gap-3">
                  <span
                    class="w-3.5 h-3.5 rounded-full shrink-0 shadow-md"
                    style={`background-color: ${product.color}; box-shadow: 0 0 12px ${product.color}80;`}
                  ></span>
                  <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight group-hover:text-violet-300 transition-colors">
                    {product.name}
                  </h2>
                </div>

                <div class="flex items-center gap-3">
                  <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    {product.status}
                  </span>
                </div>
              </div>

              <!-- Tagline & Description -->
              <h3 class="text-lg sm:text-xl font-medium text-gray-200 mb-3 leading-snug">
                {product.tagline}
              </h3>
              <p class="text-gray-400 text-sm sm:text-base leading-relaxed max-w-3xl mb-8">
                {product.description}
              </p>

              <!-- Tech Badges -->
              <div class="flex flex-wrap gap-2 mb-8">
                {product.tags.map((tag) => (
                  <span class="px-3 py-1 rounded-xl bg-white/[0.04] border border-white/[0.08] text-gray-300 text-xs font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Action Footer -->
            <div class="pt-6 border-t border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <span class="text-xs text-gray-400 flex items-center gap-2">
                <span class="text-violet-400 font-semibold">Impacto:</span> {product.metrics}
              </span>

              <a
                href={product.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-violet-600 hover:bg-violet-500 text-white font-semibold text-sm transition-all shadow-lg shadow-violet-600/30 hover:shadow-violet-600/50 group/btn cursor-pointer"
              >
                <span>Probar {product.name}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="transition-transform group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </section>

      <!-- Custom Software / Consulting CTA Card -->
      <section class="mt-16 md:mt-24">
        <div
          class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-[#12192e] via-[#0d1322] to-[#070a13] border border-white/10 p-8 sm:p-12 md:p-16 text-center shadow-2xl shadow-black/50"
        >
          <div
            class="absolute top-0 right-0 w-96 h-96 bg-violet-600/10 blur-[100px] rounded-full pointer-events-none"
          >
          </div>
          <div
            class="absolute bottom-0 left-0 w-96 h-96 bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"
          >
          </div>

          <div class="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
            <span
              class="px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-6"
            >
              Proyectos Personalizados
            </span>

            <h3 class="text-3xl sm:text-5xl font-bold text-white tracking-tight mb-4">
              ¿Tienes una plataforma o herramienta en mente?
            </h3>

            <p class="text-gray-400 text-base sm:text-lg mb-10 leading-relaxed font-light">
              Desde la arquitectura de bases de datos y APIs en tiempo real hasta interfaces de usuario de alta fidelidad. Desarrollemos tu software listo para producción.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center w-full">
              <a
                href="https://wa.me/18573975959"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto px-8 py-4 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-full transition-all shadow-xl shadow-emerald-600/30 hover:shadow-emerald-600/50 text-base flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>💬 Escríbeme por WhatsApp</span>
              </a>

              <button
                type="button"
                class="contact-trigger w-full sm:w-auto px-8 py-4 bg-violet-600 hover:bg-violet-500 text-white font-semibold rounded-full transition-all shadow-xl shadow-violet-600/30 hover:shadow-violet-600/50 text-base cursor-pointer"
              >
                <span>Hablemos (Otros canales)</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="text-gray-500 text-center py-8 mt-16 border-t border-white/5 text-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>&copy; 2026 Robert Romero Medina. Creado con Astro & Tailwind.</p>
        <div class="flex items-center gap-6 text-xs text-gray-400">
          <a href="/es" class="hover:text-white transition-colors">Inicio</a>
          <a href="/projects" class="hover:text-white transition-colors">Proyectos</a>
          <a href="/links" class="hover:text-white transition-colors">Enlaces</a>
          <a href="https://github.com/robertfrontend" target="_blank" class="hover:text-white transition-colors">GitHub</a>
          <a href="https://linkedin.com/in/robertfrontend" target="_blank" class="hover:text-white transition-colors">LinkedIn</a>
          <a href="https://x.com/robertfrontend" target="_blank" class="hover:text-white transition-colors">X (Twitter)</a>
        </div>
      </footer>
    </main>

    <!-- Glassmorphic Contact Modal -->
    <dialog id="modalContact" class="modal">
      <div
        class="modal-box bg-[#0d1322]/95 border border-white/10 text-center shadow-2xl shadow-violet-500/20 backdrop-blur-2xl max-w-md p-8 rounded-3xl"
      >
        <div class="w-12 h-12 rounded-2xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center mx-auto mb-4 text-2xl">
          💬
        </div>
        <h3 class="font-bold text-white text-2xl mb-2">Hablemos</h3>
        <p class="text-gray-400 text-sm mb-6">
          Disponible para proyectos a medida y colaboraciones.
        </p>

        <ul class="space-y-3">
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="mailto:robert@robertfrontend.com"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-violet-600/20 border border-white/[0.08] hover:border-violet-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">✉️</span>
                <span>Email</span>
              </div>
              <span class="text-xs text-violet-300 font-mono">robert@robertfrontend.com</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://wa.me/18573975959"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-emerald-600/20 border border-white/[0.08] hover:border-emerald-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">📱</span>
                <span>WhatsApp</span>
              </div>
              <span class="text-xs text-emerald-300 font-mono">+1 (857) 397-5959</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://x.com/robertfrontend"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-sky-600/20 border border-white/[0.08] hover:border-sky-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">𝕏</span>
                <span>X (Twitter)</span>
              </div>
              <span class="text-xs text-sky-300 font-mono">@robertfrontend</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://linkedin.com/in/robertfrontend"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-blue-600/20 border border-white/[0.08] hover:border-blue-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">💼</span>
                <span>LinkedIn</span>
              </div>
              <span class="text-xs text-blue-300">/in/robertfrontend</span>
            </a>
          </li>
          <li>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://instagram.com/robertfrontend"
              class="flex items-center justify-between px-5 py-3.5 rounded-2xl bg-white/[0.04] hover:bg-pink-600/20 border border-white/[0.08] hover:border-pink-500/40 text-white transition-all font-semibold text-sm group"
            >
              <div class="flex items-center gap-3">
                <span class="text-lg">📸</span>
                <span>Instagram</span>
              </div>
              <span class="text-xs text-pink-300">@robertfrontend</span>
            </a>
          </li>
        </ul>

        <div class="modal-action mt-6 flex justify-center">
          <form method="dialog">
            <button
              class="px-6 py-2 rounded-full text-xs font-semibold text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors cursor-pointer"
              >Cerrar</button
            >
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop bg-black/70 backdrop-blur-md">
        <button>close</button>
      </form>
    </dialog>
  </div>
</Layout>

<script>
  function setupContactTriggers() {
    const contactButtons = document.querySelectorAll(".contact-trigger");
    const modal = document.getElementById("modalContact") as HTMLDialogElement | null;

    if (modal && contactButtons.length > 0) {
      contactButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          modal.showModal();
        });
      });
    }
  }

  document.addEventListener("DOMContentLoaded", setupContactTriggers);
  setupContactTriggers();
</script>
